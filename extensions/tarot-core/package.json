      {
        "command": "tarot.specs.create",
        "title": "%command.specs.create.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/05-the-hierophant.svg",
          "dark": "icons/arcana/05-the-hierophant.svg"
        }
      },
      {
        "command": "tarot.specs.runTask",
        "title": "%command.specs.runTask.title%",
        "category": "Tarot IDE",
        "icon": "$(play)"
      },
      {
        "command": "tarot.specs.runTaskWith",
        "title": "%command.specs.runTaskWith.title%",
        "category": "Tarot IDE",
        "icon": "$(run-with-deps)"
      },
      {
        "command": "tarot.specs.runAllTasks",
        "title": "%command.specs.runAllTasks.title%",
        "category": "Tarot IDE",
