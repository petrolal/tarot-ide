{
  "name": "tarot-core",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "tarot",
  "author": {
    "name": "Lucas Petrola"
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/petrolal/tarot-ide.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "icon": "media/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:tarot-core",
    "watch": "gulp watch-extension:tarot-core"
  },
  "contributes": {
    "themes": [
      {
        "id": "Tarot Arcana Dark",
        "label": "%theme.arcanaDark.label%",
        "uiTheme": "vs-dark",
        "path": "./themes/tarot-dark-color-theme.json"
      },
      {
        "id": "Tarot Arcana Light",
        "label": "%theme.arcanaLight.label%",
        "uiTheme": "vs",
        "path": "./themes/tarot-light-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "tarot-arcana-icons",
        "label": "%iconTheme.arcana.label%",
        "path": "./icons/tarot-arcana-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tarot-sidebar",
          "title": "%viewsContainer.tarot.title%",
          "icon": "media/tarot-activity-icon.svg"
        },
        {
          "id": "tarot-workflows-sidebar",
          "title": "%viewsContainer.workflows.title%",
          "icon": "media/tarot-workflows-icon.svg"
        },
        {
          "id": "tarot-powers-sidebar",
          "title": "%viewsContainer.powers.title%",
          "icon": "media/tarot-powers-icon.svg"
        },
        {
          "id": "tarot-skills-sidebar",
          "title": "%viewsContainer.skills.title%",
          "icon": "media/tarot-skills-icon.svg"
        },
        {
          "id": "tarot-crew-sidebar",
          "title": "%viewsContainer.crew.title%",
          "icon": "media/tarot-crew-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "tarot-agent-sidebar",
          "title": "%viewsContainer.agent.title%",
          "icon": "media/tarot-activity-icon.svg"
        }
      ]
    },
    "views": {
      "tarot-sidebar": [
        {
          "id": "tarot.views.sessions",
          "name": "%view.sessions.name%"
        },
        {
          "id": "tarot.views.specs",
          "name": "%view.specs.name%"
        },
        {
          "id": "tarot.views.hooks",
          "name": "%view.hooks.name%"
        },
        {
          "id": "tarot.views.steering",
          "name": "%view.steering.name%"
        },
        {
          "id": "tarot.views.agents",
          "name": "%view.agents.name%"
        },
        {
          "id": "tarot.views.mcp",
          "name": "%view.mcp.name%"
        }
      ],
      "tarot-workflows-sidebar": [
        {
          "id": "tarot.views.workflowRuns",
          "name": "%view.workflowRuns.name%"
        },
        {
          "id": "tarot.views.recipes",
          "name": "%view.recipes.name%"
        }
      ],
      "tarot-powers-sidebar": [
        {
          "id": "tarot.views.powers",
          "name": "%view.powers.name%"
        },
        {
          "id": "tarot.views.availablePowers",
          "name": "%view.availablePowers.name%"
        }
      ],
      "tarot-skills-sidebar": [
        {
          "id": "tarot.views.skills",
          "name": "%view.skills.name%"
        },
        {
          "id": "tarot.views.customAgents",
          "name": "%view.customAgents.name%"
        }
      ],
      "tarot-crew-sidebar": [
        {
          "id": "tarot.views.crewmates",
          "name": "%view.crewmates.name%"
        },
        {
          "id": "tarot.views.crewTasks",
          "name": "%view.crewTasks.name%"
        },
        {
          "id": "tarot.views.crewMemory",
          "name": "%view.crewMemory.name%"
        },
        {
          "id": "tarot.views.crewSchedules",
          "name": "%view.crewSchedules.name%"
        },
        {
          "id": "tarot.views.crewChannels",
          "name": "%view.crewChannels.name%"
        }
      ],
      "tarot-agent-sidebar": [
        {
          "type": "webview",
          "id": "tarot.views.agentPanel",
          "name": "%view.agentPanel.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tarot.views.specs",
        "contents": "%viewsWelcome.specs.contents%"
      },
      {
        "view": "tarot.views.hooks",
        "contents": "%viewsWelcome.hooks.contents%"
      },
      {
        "view": "tarot.views.steering",
        "contents": "%viewsWelcome.steering.contents%"
      },
      {
        "view": "tarot.views.mcp",
        "contents": "%viewsWelcome.mcp.contents%"
      },
      {
        "view": "tarot.views.workflowRuns",
        "contents": "%viewsWelcome.workflowRuns.contents%"
      },
      {
        "view": "tarot.views.powers",
        "contents": "%viewsWelcome.powers.contents%"
      },
      {
        "view": "tarot.views.skills",
        "contents": "%viewsWelcome.skills.contents%"
      },
      {
        "view": "tarot.views.crewmates",
        "contents": "%viewsWelcome.crewmates.contents%"
      },
      {
        "view": "tarot.views.crewTasks",
        "contents": "%viewsWelcome.crewTasks.contents%"
      },
      {
        "view": "tarot.views.crewSchedules",
        "contents": "%viewsWelcome.crewSchedules.contents%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tarot.sessions.new",
          "when": "view == tarot.views.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tarot.sessions.search",
          "when": "view == tarot.views.sessions",
          "group": "navigation@2"
        },
        {
          "command": "tarot.sessions.filter",
          "when": "view == tarot.views.sessions",
          "group": "navigation@3"
        },
        {
          "command": "tarot.specs.create",
          "when": "view == tarot.views.specs",
          "group": "navigation"
        },
        {
          "command": "tarot.hooks.create",
          "when": "view == tarot.views.hooks",
          "group": "navigation"
        },
        {
          "command": "tarot.steering.generate",
          "when": "view == tarot.views.steering",
          "group": "navigation"
        },
        {
          "command": "tarot.steering.create",
          "when": "view == tarot.views.steering",
          "group": "navigation"
        },
        {
          "command": "tarot.agents.refresh",
          "when": "view == tarot.views.agents",
          "group": "navigation"
        },
        {
          "command": "tarot.mcp.openConfig",
          "when": "view == tarot.views.mcp",
          "group": "navigation"
        },
        {
          "command": "tarot.workflows.searchRuns",
          "when": "view == tarot.views.workflowRuns",
          "group": "navigation@1"
        },
        {
          "command": "tarot.workflows.run",
          "when": "view == tarot.views.recipes",
          "group": "navigation@1"
        },
        {
          "command": "tarot.powers.install",
          "when": "view == tarot.views.powers",
          "group": "navigation@1"
        },
        {
          "command": "tarot.powers.create",
          "when": "view == tarot.views.powers",
          "group": "navigation@2"
        },
        {
          "command": "tarot.powers.search",
          "when": "view == tarot.views.powers || view == tarot.views.availablePowers",
          "group": "navigation@3"
        },
        {
          "command": "tarot.powers.refresh",
          "when": "view == tarot.views.powers",
          "group": "navigation@4"
        },
        {
          "command": "tarot.skills.create",
          "when": "view == tarot.views.skills",
          "group": "navigation@1"
        },
        {
          "command": "tarot.skills.import",
          "when": "view == tarot.views.skills",
          "group": "navigation@2"
        },
        {
          "command": "tarot.skills.refresh",
          "when": "view == tarot.views.skills",
          "group": "navigation@3"
        },
        {
          "command": "tarot.agents.createCustom",
          "when": "view == tarot.views.customAgents",
          "group": "navigation@1"
        },
        {
          "command": "tarot.agents.refreshProfiles",
          "when": "view == tarot.views.customAgents",
          "group": "navigation@2"
        },
        {
          "command": "tarot.crew.createCrewmate",
          "when": "view == tarot.views.crewmates",
          "group": "navigation@1"
        },
        {
          "command": "tarot.crew.refresh",
          "when": "view == tarot.views.crewmates",
          "group": "navigation@2"
        },
        {
          "command": "tarot.crew.createTaskFile",
          "when": "view == tarot.views.crewTasks",
          "group": "navigation@1"
        },
        {
          "command": "tarot.crew.addKnowledgeSource",
          "when": "view == tarot.views.crewMemory",
          "group": "navigation@1"
        },
        {
          "command": "tarot.crew.searchKnowledge",
          "when": "view == tarot.views.crewMemory",
          "group": "navigation@2"
        },
        {
          "command": "tarot.schedule.create",
          "when": "view == tarot.views.crewSchedules",
          "group": "navigation@1"
        },
        {
          "command": "tarot.schedule.viewDigest",
          "when": "view == tarot.views.crewSchedules",
          "group": "navigation@2"
        },
        {
          "command": "tarot.crew.gateway.configure",
          "when": "view == tarot.views.crewChannels",
          "group": "navigation@1"
        },
        {
          "command": "tarot.crew.apps.create",
          "when": "view == tarot.views.crewChannels",
          "group": "navigation@2"
        },
        {
          "command": "tarot.crew.remote.add",
          "when": "view == tarot.views.crewChannels",
          "group": "navigation@3"
        },
        {
          "command": "tarot.agent.toggleFocusMode",
          "when": "view == tarot.views.agentPanel",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "tarot.agent.sendSelection",
          "group": "1_modification@10"
        },
        {
          "command": "tarot.agent.sendSelectionToNewSession",
          "group": "1_modification@11"
        },
        {
          "submenu": "tarot.askTarot",
          "group": "1_modification@12"
        }
      ],
      "tarot.askTarot": [
        {
          "command": "tarot.agent.quickAction.fixGrammar",
          "group": "1_actions@1"
        },
        {
          "command": "tarot.agent.quickAction.writeComments",
          "group": "1_actions@2"
        },
        {
          "command": "tarot.agent.quickAction.optimize",
          "group": "1_actions@3"
        }
      ],
      "editor/title": [
        {
          "command": "tarot.agent.toggleFocusMode",
          "group": "navigation@100"
        },
        {
          "command": "tarot.specs.runAllTasks",
          "when": "resourceFilename == tasks.md",
          "group": "navigation@50"
        },
        {
          "command": "tarot.specs.syncFiles",
          "when": "resourceFilename == tasks.md",
          "group": "navigation@51"
        },
        {
          "command": "tarot.review.acceptFile",
          "when": "tarot.hasPendingReview",
          "group": "navigation@10"
        },
        {
          "command": "tarot.review.rejectFile",
          "when": "tarot.hasPendingReview",
          "group": "navigation@11"
        },
        {
          "command": "tarot.review.acceptAll",
          "when": "tarot.hasPendingReview",
          "group": "navigation@12"
        },
        {
          "command": "tarot.review.rejectAll",
          "when": "tarot.hasPendingReview",
          "group": "navigation@13"
        },
        {
          "command": "tarot.review.nextFile",
          "when": "tarot.hasPendingReview",
          "group": "navigation@14"
        }
      ],
      "scm/title": [
        {
          "command": "tarot.git.generateCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "tarot.git.prePrReview",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tarot.hooks.runManual",
          "when": "view == tarot.views.hooks && (viewItem == tarotHookEnabled || viewItem == tarotHookDisabled)",
          "group": "inline@1"
        },
        {
          "command": "tarot.hooks.toggle",
          "when": "view == tarot.views.hooks && (viewItem == tarotHookEnabled || viewItem == tarotHookDisabled)",
          "group": "inline@2"
        },
        {
          "command": "tarot.workflows.runRecipe",
          "when": "view == tarot.views.recipes && viewItem == tarotWorkflowRecipe",
          "group": "inline@1"
        },
        {
          "command": "tarot.powers.uninstall",
          "when": "view == tarot.views.powers && viewItem == tarotPowerInstalled",
          "group": "inline@1"
        },
        {
          "command": "tarot.powers.installCurated",
          "when": "view == tarot.views.availablePowers && viewItem == tarotPowerAvailable",
          "group": "inline@1"
        },
        {
          "command": "tarot.agents.selectProfile",
          "when": "view == tarot.views.customAgents && viewItem == tarotCustomAgent",
          "group": "inline@1"
        },
        {
          "command": "tarot.crew.startSession",
          "when": "view == tarot.views.crewmates && viewItem == tarotCrewmate",
          "group": "inline@1"
        },
        {
          "command": "tarot.crew.toggleStar",
          "when": "view == tarot.views.crewmates && viewItem == tarotCrewmate",
          "group": "inline@2"
        },
        {
          "command": "tarot.crew.runTaskFile",
          "when": "view == tarot.views.crewTasks && viewItem == tarotCrewTaskFile",
          "group": "inline@1"
        },
        {
          "command": "tarot.crew.scanKnowledgeSource",
          "when": "view == tarot.views.crewMemory && viewItem == tarotKnowledgeSource",
          "group": "inline@1"
        },
        {
          "command": "tarot.crew.removeKnowledgeSource",
          "when": "view == tarot.views.crewMemory && viewItem == tarotKnowledgeSource",
          "group": "inline@2"
        },
        {
          "command": "tarot.schedule.runNow",
          "when": "view == tarot.views.crewSchedules && (viewItem == tarotScheduleEnabled || viewItem == tarotScheduleDisabled)",
          "group": "inline@1"
        },
        {
          "command": "tarot.crew.toggleSchedule",
          "when": "view == tarot.views.crewSchedules && (viewItem == tarotScheduleEnabled || viewItem == tarotScheduleDisabled)",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tarot.powers.openDetail",
          "when": "false"
        },
        {
          "command": "tarot.powers.installCurated",
          "when": "false"
        },
        {
          "command": "tarot.crew.toggleStar",
          "when": "false"
        },
        {
          "command": "tarot.crew.startSession",
          "when": "false"
        },
        {
          "command": "tarot.crew.openMemoryFile",
          "when": "false"
        },
        {
          "command": "tarot.crew.scanKnowledgeSource",
          "when": "false"
        },
        {
          "command": "tarot.crew.removeKnowledgeSource",
          "when": "false"
        },
        {
          "command": "tarot.crew.toggleSchedule",
          "when": "false"
        },
        {
          "command": "tarot.workflows.previewRecipe",
          "when": "false"
        },
        {
          "command": "tarot.hooks.openEditor",
          "when": "false"
        },
        {
          "command": "tarot.schedule.openEditor",
          "when": "false"
        },
        {
          "command": "tarot.agents.selectById",
          "when": "false"
        },
        {
          "command": "tarot.specs.runTask",
          "when": "false"
        },
        {
          "command": "tarot.specs.runTaskWith",
          "when": "false"
        },
        {
          "command": "tarot.specs.viewTaskChanges",
          "when": "false"
        },
        {
          "command": "tarot.hooks.runManual",
          "when": "false"
        },
        {
          "command": "tarot.hooks.toggle",
          "when": "false"
        },
        {
          "command": "tarot.workflows.openRun",
          "when": "false"
        },
        {
          "command": "tarot.workflows.runRecipe",
          "when": "false"
        },
        {
          "command": "tarot.sessions.open",
          "when": "false"
        },
        {
          "command": "tarot.review.acceptHunk",
          "when": "false"
        },
        {
          "command": "tarot.review.rejectHunk",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "tarot.askTarot",
        "label": "%submenu.askTarot.label%"
      }
    ],
    "keybindings": [
      {
        "command": "tarot.agent.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "tarot.agent.sendSelectionToNewSession",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "workbench.action.toggleAuxiliaryBar",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      },
      {
        "command": "tarot.agent.toggleFocusMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "tarot.review.acceptFile",
        "key": "alt+y",
        "mac": "alt+y",
        "when": "tarot.hasPendingReview && editorTextFocus"
      },
      {
        "command": "tarot.review.rejectFile",
        "key": "alt+n",
        "mac": "alt+n",
        "when": "tarot.hasPendingReview && editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.commandCenter": true,
      "window.menuBarVisibility": "compact",
      "editor.minimap.enabled": false
    },
    "configuration": {
      "title": "Tarot IDE",
      "properties": {
        "tarot.ui.openAgentPanelOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.ui.openAgentPanelOnStartup.description%"
        },
        "tarot.compaction.autoThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.5,
          "maximum": 0.95,
          "description": "%config.compaction.autoThreshold.description%"
        },
        "tarot.compaction.excludeMessages": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.compaction.excludeMessages.description%"
        },
        "tarot.workflows.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.workflows.enabled.description%"
        },
        "tarot.workflows.useWorkflows": {
          "type": "string",
          "default": "onlyWhenAsked",
          "enum": [
            "onlyWhenAsked",
            "onlyForLargeTasks",
            "asMuchAsPossible"
          ],
          "description": "%config.workflows.useWorkflows.description%"
        },
        "tarot.specs.defaultWorkflow": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "spec",
            "plan",
            "bugfix",
            "quick-spec"
          ],
          "description": "%config.specs.defaultWorkflow.description%"
        },
        "tarot.agents.default": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "claude",
            "agy",
            "codex"
          ],
          "description": "%config.agents.default.description%"
        },
        "tarot.agents.paths.claude": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.claude.description%"
        },
        "tarot.agents.paths.agy": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.agy.description%"
        },
        "tarot.agents.paths.codex": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.codex.description%"
        },
        "tarot.agents.timeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "%config.agents.timeoutMs.description%"
        },
        "tarot.agents.custom": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "%config.agents.custom.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "displayName",
              "binary"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "binary": {
                "type": "string"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "cli",
                  "acp"
                ],
                "default": "cli"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "versionArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "walkthroughs": [
      {
        "id": "tarot.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "icon": "media/icon.png",
        "featuredFor": [
          "*"
        ],
        "steps": [
          {
            "id": "tarot.welcomeStep",
            "title": "%walkthrough.step.welcome.title%",
            "description": "%walkthrough.step.welcome.description%",
            "media": {
              "image": "media/splash.png",
              "altText": "Tarot IDE — Arcana Code Environment"
            }
          },
          {
            "id": "tarot.themeStep",
            "title": "%walkthrough.step.theme.title%",
            "description": "%walkthrough.step.theme.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Tarot Arcana Dark & Icons"
            }
          },
          {
            "id": "tarot.extensionsStep",
            "title": "%walkthrough.step.extensions.title%",
            "description": "%walkthrough.step.extensions.description%",
            "media": {
              "image": "media/icon.png",
              "altText": "Open VSX Extensions"
            }
          }
        ]
      }
    ],
