      {
        "command": "tarot.agents.refresh",
        "title": "%command.agents.refresh.title%",
        "category": "Tarot IDE",
        "icon": "$(refresh)"
      },
      {
        "command": "tarot.agents.selectById",
        "title": "%command.agents.selectById.title%",
        "category": "Tarot IDE",
        "icon": "$(check)"
