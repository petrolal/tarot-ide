{
  "name": "tarot-core",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "tarot",
  "author": {
    "name": "Lucas Petrola"
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/petrolal/tarot-ide.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "icon": "media/icon.png",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:tarot-core",
    "watch": "gulp watch-extension:tarot-core"
  },
  "contributes": {
    "themes": [
      {
        "id": "Tarot Arcana Dark",
        "label": "%theme.arcanaDark.label%",
        "uiTheme": "vs-dark",
        "path": "./themes/tarot-dark-color-theme.json"
      },
      {
        "id": "Tarot Arcana Light",
        "label": "%theme.arcanaLight.label%",
        "uiTheme": "vs",
        "path": "./themes/tarot-light-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "tarot-arcana-icons",
        "label": "%iconTheme.arcana.label%",
        "path": "./icons/tarot-arcana-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tarot-sidebar",
          "title": "%viewsContainer.tarot.title%",
          "icon": "media/tarot-activity-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "tarot-agent-sidebar",
          "title": "%viewsContainer.agent.title%",
          "icon": "media/tarot-activity-icon.svg"
        }
      ]
    },
    "views": {
      "tarot-sidebar": [
        {
          "id": "tarot.views.sessions",
          "name": "%view.sessions.name%"
        },
        {
          "id": "tarot.views.specs",
          "name": "%view.specs.name%"
        },
        {
          "id": "tarot.views.hooks",
          "name": "%view.hooks.name%"
        },
        {
          "id": "tarot.views.steering",
          "name": "%view.steering.name%"
        },
        {
          "id": "tarot.views.agents",
          "name": "%view.agents.name%"
        },
        {
          "id": "tarot.views.mcp",
          "name": "%view.mcp.name%"
        },
        {
          "id": "tarot.views.workflowRuns",
          "name": "%view.workflowRuns.name%"
        },
        {
          "id": "tarot.views.recipes",
          "name": "%view.recipes.name%"
        }
      ],
      "tarot-agent-sidebar": [
        {
          "type": "webview",
          "id": "tarot.views.agentPanel",
          "name": "%view.agentPanel.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tarot.views.specs",
        "contents": "%viewsWelcome.specs.contents%"
      },
      {
        "view": "tarot.views.hooks",
        "contents": "%viewsWelcome.hooks.contents%"
      },
      {
        "view": "tarot.views.steering",
        "contents": "%viewsWelcome.steering.contents%"
      },
      {
        "view": "tarot.views.mcp",
        "contents": "%viewsWelcome.mcp.contents%"
      },
      {
        "view": "tarot.views.workflowRuns",
        "contents": "%viewsWelcome.workflowRuns.contents%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tarot.sessions.new",
          "when": "view == tarot.views.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tarot.sessions.search",
          "when": "view == tarot.views.sessions",
          "group": "navigation@2"
        },
        {
          "command": "tarot.sessions.filter",
          "when": "view == tarot.views.sessions",
          "group": "navigation@3"
        },
        {
          "command": "tarot.specs.create",
          "when": "view == tarot.views.specs",
          "group": "navigation"
        },
        {
          "command": "tarot.hooks.create",
          "when": "view == tarot.views.hooks",
          "group": "navigation"
        },
        {
          "command": "tarot.steering.generate",
          "when": "view == tarot.views.steering",
          "group": "navigation"
        },
        {
          "command": "tarot.steering.create",
          "when": "view == tarot.views.steering",
          "group": "navigation"
        },
        {
          "command": "tarot.agents.refresh",
          "when": "view == tarot.views.agents",
          "group": "navigation"
        },
        {
          "command": "tarot.mcp.openConfig",
          "when": "view == tarot.views.mcp",
          "group": "navigation"
        },
        {
          "command": "tarot.workflows.searchRuns",
          "when": "view == tarot.views.workflowRuns",
          "group": "navigation@1"
        },
        {
          "command": "tarot.workflows.run",
          "when": "view == tarot.views.recipes",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "tarot.agent.sendSelection",
          "group": "1_modification@10"
        },
        {
          "command": "tarot.agent.sendSelectionToNewSession",
          "group": "1_modification@11"
        },
        {
          "submenu": "tarot.askTarot",
          "group": "1_modification@12"
        }
      ],
      "tarot.askTarot": [
        {
          "command": "tarot.agent.quickAction.fixGrammar",
          "group": "1_actions@1"
        },
        {
          "command": "tarot.agent.quickAction.writeComments",
          "group": "1_actions@2"
        },
        {
          "command": "tarot.agent.quickAction.optimize",
          "group": "1_actions@3"
        }
      ],
      "editor/title": [
        {
          "command": "tarot.agent.toggleFocusMode",
          "group": "navigation@100"
        },
        {
          "command": "tarot.specs.runAllTasks",
          "when": "resourceFilename == tasks.md",
          "group": "navigation@50"
        },
        {
          "command": "tarot.specs.syncFiles",
          "when": "resourceFilename == tasks.md",
          "group": "navigation@51"
        }
      ],
      "scm/title": [
        {
          "command": "tarot.git.generateCommitMessage",
          "group": "navigation@1"
        },
        {
          "command": "tarot.git.prePrReview",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tarot.hooks.runManual",
          "when": "view == tarot.views.hooks && (viewItem == tarotHookEnabled || viewItem == tarotHookDisabled)",
          "group": "inline@1"
        },
        {
          "command": "tarot.hooks.toggle",
          "when": "view == tarot.views.hooks && (viewItem == tarotHookEnabled || viewItem == tarotHookDisabled)",
          "group": "inline@2"
        },
        {
          "command": "tarot.workflows.runRecipe",
          "when": "view == tarot.views.recipes && viewItem == tarotWorkflowRecipe",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tarot.agents.selectById",
          "when": "false"
        },
        {
          "command": "tarot.specs.runTask",
          "when": "false"
        },
        {
          "command": "tarot.specs.runTaskWith",
          "when": "false"
        },
        {
          "command": "tarot.specs.viewTaskChanges",
          "when": "false"
        },
        {
          "command": "tarot.hooks.runManual",
          "when": "false"
        },
        {
          "command": "tarot.hooks.toggle",
          "when": "false"
        },
        {
          "command": "tarot.workflows.openRun",
          "when": "false"
        },
        {
          "command": "tarot.workflows.runRecipe",
          "when": "false"
        },
        {
          "command": "tarot.sessions.open",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "tarot.askTarot",
        "label": "%submenu.askTarot.label%"
      }
    ],
    "keybindings": [
      {
        "command": "tarot.agent.sendSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "tarot.agent.sendSelectionToNewSession",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      },
      {
        "command": "workbench.action.toggleAuxiliaryBar",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b"
      }
    ],
    "configurationDefaults": {
      "workbench.secondarySideBar.defaultVisibility": "visible",
      "window.commandCenter": true,
      "window.menuBarVisibility": "compact",
      "editor.minimap.enabled": false
    },
    "configuration": {
      "title": "Tarot IDE",
      "properties": {
        "tarot.ui.openAgentPanelOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "%config.ui.openAgentPanelOnStartup.description%"
        },
        "tarot.compaction.autoThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0.5,
          "maximum": 0.95,
          "description": "%config.compaction.autoThreshold.description%"
        },
        "tarot.compaction.excludeMessages": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.compaction.excludeMessages.description%"
        },
        "tarot.workflows.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.workflows.enabled.description%"
        },
        "tarot.workflows.useWorkflows": {
          "type": "string",
          "default": "onlyWhenAsked",
          "enum": [
            "onlyWhenAsked",
            "onlyForLargeTasks",
            "asMuchAsPossible"
          ],
          "description": "%config.workflows.useWorkflows.description%"
        },
        "tarot.specs.defaultWorkflow": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "spec",
            "plan",
            "bugfix",
            "quick-spec"
          ],
          "description": "%config.specs.defaultWorkflow.description%"
        },
        "tarot.agents.default": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "claude",
            "agy",
            "codex"
          ],
          "description": "%config.agents.default.description%"
        },
        "tarot.agents.paths.claude": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.claude.description%"
        },
        "tarot.agents.paths.agy": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.agy.description%"
        },
        "tarot.agents.paths.codex": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.agents.paths.codex.description%"
        },
        "tarot.agents.timeoutMs": {
          "type": "number",
          "default": 300000,
          "minimum": 10000,
          "description": "%config.agents.timeoutMs.description%"
        },
        "tarot.agents.custom": {
          "type": "array",
          "default": [],
          "scope": "machine",
          "description": "%config.agents.custom.description%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "displayName",
              "binary"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "binary": {
                "type": "string"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "cli",
                  "acp"
                ],
                "default": "cli"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "versionArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "walkthroughs": [
      {
        "id": "tarot.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "icon": "media/icon.png",
        "featuredFor": [
          "*"
        ],
        "steps": [
          {
            "id": "tarot.welcomeStep",
            "title": "%walkthrough.step.welcome.title%",
            "description": "%walkthrough.step.welcome.description%",
            "media": {
              "image": "media/splash.png",
              "altText": "Tarot IDE — Arcana Code Environment"
            }
          },
          {
            "id": "tarot.themeStep",
            "title": "%walkthrough.step.theme.title%",
            "description": "%walkthrough.step.theme.description%",
            "media": {
              "image": "media/logo.png",
              "altText": "Tarot Arcana Dark & Icons"
            }
          },
          {
            "id": "tarot.extensionsStep",
            "title": "%walkthrough.step.extensions.title%",
            "description": "%walkthrough.step.extensions.description%",
            "media": {
              "image": "media/icon.png",
              "altText": "Open VSX Extensions"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "tarot.welcome",
        "title": "%command.welcome.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.agentPanel.open",
        "title": "%command.agentPanel.open.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.agent.sendSelection",
        "title": "%command.agent.sendSelection.title%",
        "category": "Tarot IDE",
        "icon": "$(sparkle)"
      },
      {
        "command": "tarot.agent.openInEditorTab",
        "title": "%command.agent.openInEditorTab.title%",
        "category": "Tarot IDE",
        "icon": "$(open-preview)"
      },
      {
        "command": "tarot.agent.toggleFocusMode",
        "title": "%command.agent.toggleFocusMode.title%",
        "category": "Tarot IDE",
        "icon": "$(layout-centered)"
      },
      {
        "command": "tarot.git.generateCommitMessage",
        "title": "%command.git.generateCommitMessage.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/17-the-star.svg",
          "dark": "icons/arcana/17-the-star.svg"
        }
      },
      {
        "command": "tarot.agents.select",
        "title": "%command.agents.select.title%",
        "category": "Tarot IDE"
