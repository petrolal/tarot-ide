        "command": "tarot.workflows.openRun",
        "title": "%command.workflows.openRun.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.workflows.runRecipe",
        "title": "%command.workflows.runRecipe.title%",
