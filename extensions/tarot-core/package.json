      {
        "command": "tarot.specs.viewTaskChanges",
        "title": "%command.specs.viewTaskChanges.title%",
        "category": "Tarot IDE",
        "icon": "$(diff)"
      },
      {
        "command": "tarot.hooks.runManual",
        "title": "%command.hooks.runManual.title%",
        "category": "Tarot IDE",
