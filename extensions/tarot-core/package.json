      {
        "command": "tarot.permissions.openUserPermissions",
        "title": "%command.permissions.openUserPermissions.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/05-the-hierophant.svg",
          "dark": "icons/arcana/05-the-hierophant.svg"
        }
      },
      {
        "command": "tarot.permissions.openWorkspacePermissions",
        "title": "%command.permissions.openWorkspacePermissions.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/05-the-hierophant.svg",
          "dark": "icons/arcana/05-the-hierophant.svg"
        }
      },
      {
        "command": "tarot.specs.openPhase",
        "title": "%command.specs.openPhase.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.specs.analyzeRequirements",
        "title": "%command.specs.analyzeRequirements.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/09-the-hermit.svg",
          "dark": "icons/arcana/09-the-hermit.svg"
        }
      },
      {
        "command": "tarot.specs.quickSpec",
        "title": "%command.specs.quickSpec.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/00-the-fool.svg",
          "dark": "icons/arcana/00-the-fool.svg"
        }
      },
      {
        "command": "tarot.specs.generateFromSession",
        "title": "%command.specs.generateFromSession.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/05-the-hierophant.svg",
          "dark": "icons/arcana/05-the-hierophant.svg"
        }
      },
      {
        "command": "tarot.specs.markdownReview.add",
        "title": "%command.specs.markdownReview.add.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.specs.markdownReview.send",
        "title": "%command.specs.markdownReview.send.title%",
        "category": "Tarot IDE"
      },
      {
        "command": "tarot.steering.create",
        "title": "%command.steering.create.title%",
        "category": "Tarot IDE",
        "icon": "$(add)"
      },
      {
        "command": "tarot.steering.generate",
        "title": "%command.steering.generate.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/02-high-priestess.svg",
          "dark": "icons/arcana/02-high-priestess.svg"
        }
      },
      {
        "command": "tarot.hooks.create",
        "title": "%command.hooks.create.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/10-wheel-of-fortune.svg",
          "dark": "icons/arcana/10-wheel-of-fortune.svg"
        }
      },
      {
        "command": "tarot.skills.import",
        "title": "%command.skills.import.title%",
        "category": "Tarot IDE",
        "icon": {
          "light": "icons/arcana/light/02-high-priestess.svg",
          "dark": "icons/arcana/02-high-priestess.svg"
