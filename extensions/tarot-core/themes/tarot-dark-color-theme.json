{
	"$schema": "vscode://schemas/color-theme",
	"name": "Tarot Arcana Dark",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"focusBorder": "#8B5CF6",
		"foreground": "#D8D4E4",
		"disabledForeground": "#76718A",
		"textLink.foreground": "#B794F4",
		"textLink.activeForeground": "#D4AF37",
		"widget.border": "#FFFFFF14",
		"widget.shadow": "#00000080",
		"selection.background": "#6D28D955",
		"icon.foreground": "#B8B2C8",

		"titleBar.activeBackground": "#100F17",
		"titleBar.activeForeground": "#D8D4E4",
		"titleBar.inactiveBackground": "#100F17",
		"titleBar.inactiveForeground": "#7E7992",
		"titleBar.border": "#FFFFFF0D",

		"commandCenter.foreground": "#B8B2C8",
		"commandCenter.activeForeground": "#F2EFE9",
		"commandCenter.background": "#181622",
		"commandCenter.activeBackground": "#1E1B2B",
		"commandCenter.border": "#FFFFFF10",
		"commandCenter.activeBorder": "#8B5CF680",

		"activityBar.background": "#100F17",
		"activityBar.foreground": "#E6E2F0",
		"activityBar.inactiveForeground": "#6F6A82",
		"activityBar.activeBorder": "#8B5CF6",
		"activityBar.border": "#FFFFFF0A",
		"activityBarBadge.background": "#5B21B6",
		"activityBarBadge.foreground": "#FFFFFF",

		"sideBar.background": "#12111A",
		"sideBar.foreground": "#C8C3D6",
		"sideBar.border": "#FFFFFF0D",
		"sideBarTitle.foreground": "#948FA8",
		"sideBarSectionHeader.background": "#12111A",
		"sideBarSectionHeader.foreground": "#D8D4E4",
		"sideBarSectionHeader.border": "#FFFFFF0A",

		"editorGroupHeader.tabsBackground": "#12111A",
		"editorGroupHeader.tabsBorder": "#FFFFFF0D",
		"editorGroup.border": "#FFFFFF0D",
		"tab.activeBackground": "#16141E",
		"tab.activeForeground": "#F2EFE9",
		"tab.inactiveBackground": "#12111A",
		"tab.inactiveForeground": "#88839B",
		"tab.hoverBackground": "#1B1926",
		"tab.activeBorderTop": "#8B5CF6",
		"tab.border": "#00000000",

		"editor.background": "#16141E",
		"editor.foreground": "#E6E2F0",
		"editorCursor.foreground": "#D4AF37",
		"editor.lineHighlightBackground": "#FFFFFF07",
		"editor.lineHighlightBorder": "#00000000",
		"editor.selectionBackground": "#6D28D94D",
		"editor.inactiveSelectionBackground": "#6D28D92B",
		"editor.selectionHighlightBackground": "#D4AF371F",
		"editor.wordHighlightBackground": "#4FD1C51F",
		"editor.findMatchBackground": "#D4AF3740",
		"editor.findMatchHighlightBackground": "#6D28D94D",
		"editorLineNumber.foreground": "#5C5770",
		"editorLineNumber.activeForeground": "#C8C3D6",
		"editorIndentGuide.background1": "#FFFFFF0D",
		"editorIndentGuide.activeBackground1": "#8B5CF666",
		"editorBracketMatch.background": "#6D28D938",
		"editorBracketMatch.border": "#8B5CF688",
		"editorError.foreground": "#F87171",
		"editorWarning.foreground": "#E5C07B",
		"editorInfo.foreground": "#4FD1C5",
		"editorGutter.background": "#16141E",
		"editorGutter.addedBackground": "#86D9A5",
		"editorGutter.modifiedBackground": "#E5C07B",
		"editorGutter.deletedBackground": "#F87171",

		"editorWidget.background": "#181622",
		"editorWidget.foreground": "#E6E2F0",
		"editorWidget.border": "#FFFFFF18",
		"editorSuggestWidget.background": "#181622",
		"editorSuggestWidget.border": "#FFFFFF18",
		"editorSuggestWidget.selectedBackground": "#6D28D944",
		"editorSuggestWidget.highlightForeground": "#D4AF37",
		"editorHoverWidget.background": "#181622",
		"editorHoverWidget.border": "#FFFFFF18",

		"breadcrumb.background": "#16141E",
		"breadcrumb.foreground": "#7E7992",
		"breadcrumb.focusForeground": "#E6E2F0",
		"breadcrumb.activeSelectionForeground": "#F2EFE9",

		"panel.background": "#12111A",
		"panel.border": "#FFFFFF0D",
		"panelTitle.activeBorder": "#8B5CF6",
		"panelTitle.activeForeground": "#F2EFE9",
		"panelTitle.inactiveForeground": "#88839B",

		"terminal.background": "#12111A",
		"terminal.foreground": "#E6E2F0",
		"terminalCursor.foreground": "#D4AF37",
		"terminal.selectionBackground": "#6D28D94D",
		"terminal.ansiBlack": "#100F17",
		"terminal.ansiRed": "#F87171",
		"terminal.ansiGreen": "#86D9A5",
		"terminal.ansiYellow": "#E5C07B",
		"terminal.ansiBlue": "#93C5FD",
		"terminal.ansiMagenta": "#C4A7F7",
		"terminal.ansiCyan": "#4FD1C5",
		"terminal.ansiWhite": "#E6E2F0",
		"terminal.ansiBrightBlack": "#6E6A86",
		"terminal.ansiBrightRed": "#FCA5A5",
		"terminal.ansiBrightGreen": "#A7F3D0",
		"terminal.ansiBrightYellow": "#F5E08E",
		"terminal.ansiBrightBlue": "#BFDBFE",
		"terminal.ansiBrightMagenta": "#DDD6FE",
		"terminal.ansiBrightCyan": "#81E6D9",
		"terminal.ansiBrightWhite": "#FFFFFF",

		"statusBar.background": "#100F17",
		"statusBar.foreground": "#8E89A3",
		"statusBar.border": "#FFFFFF0D",
		"statusBar.noFolderBackground": "#100F17",
		"statusBar.noFolderForeground": "#8E89A3",
		"statusBar.debuggingBackground": "#4B0082",
		"statusBar.debuggingForeground": "#F5E08E",
		"statusBarItem.hoverBackground": "#FFFFFF10",
		"statusBarItem.remoteBackground": "#4B0082",
		"statusBarItem.remoteForeground": "#F5E08E",

		"list.activeSelectionBackground": "#6D28D940",
		"list.activeSelectionForeground": "#FFFFFF",
		"list.inactiveSelectionBackground": "#FFFFFF0D",
		"list.inactiveSelectionForeground": "#E6E2F0",
		"list.hoverBackground": "#FFFFFF08",
		"list.highlightForeground": "#D4AF37",

		"input.background": "#1B1926",
		"input.foreground": "#E6E2F0",
		"input.border": "#FFFFFF18",
		"input.placeholderForeground": "#76718A",
		"dropdown.background": "#1B1926",
		"dropdown.foreground": "#E6E2F0",
		"dropdown.border": "#FFFFFF18",
		"button.background": "#5B21B6",
		"button.foreground": "#FFFFFF",
		"button.hoverBackground": "#6D28D9",
		"button.secondaryBackground": "#252236",
		"button.secondaryForeground": "#D8D4E4",
		"badge.background": "#5B21B6",
		"badge.foreground": "#FFFFFF",

		"menu.background": "#181622",
		"menu.foreground": "#E6E2F0",
		"menu.selectionBackground": "#6D28D955",
		"menu.selectionForeground": "#FFFFFF",
		"menu.border": "#FFFFFF18",

		"scrollbarSlider.background": "#FFFFFF14",
		"scrollbarSlider.hoverBackground": "#FFFFFF26",
		"scrollbarSlider.activeBackground": "#8B5CF666",
		"progressBar.background": "#8B5CF6",

		"gitDecoration.addedResourceForeground": "#86D9A5",
		"gitDecoration.modifiedResourceForeground": "#E5C07B",
		"gitDecoration.deletedResourceForeground": "#F87171",
		"gitDecoration.untrackedResourceForeground": "#86D9A5",
		"gitDecoration.ignoredResourceForeground": "#5C5770"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6E6A86", "fontStyle": "italic" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#C4A7F7" }
		},
		{
			"scope": ["keyword.operator", "punctuation.accessor"],
			"settings": { "foreground": "#A59EC0" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#93C5FD" }
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
			"settings": { "foreground": "#E5C07B" }
		},
		{
			"scope": ["string", "constant.other.symbol"],
			"settings": { "foreground": "#86D9A5" }
		},
		{
			"scope": ["constant.character.escape", "string.regexp"],
			"settings": { "foreground": "#E5C07B" }
		},
		{
			"scope": ["variable", "meta.definition.variable"],
			"settings": { "foreground": "#E6E2F0" }
		},
		{
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#D8C8F8", "fontStyle": "italic" }
		},
		{
			"scope": ["variable.other.property", "support.type.property-name", "entity.name.tag.yaml", "support.type.property-name.json"],
			"settings": { "foreground": "#93C5FD" }
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": { "foreground": "#F0ABFC" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#C4A7F7" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#E5C07B", "fontStyle": "italic" }
		},
		{
			"scope": ["punctuation.definition.tag", "punctuation.separator", "punctuation.terminator"],
			"settings": { "foreground": "#88839B" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#F2EFE9", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "foreground": "#D8C8F8", "fontStyle": "italic" }
		},
		{
			"scope": ["markup.inline.raw"],
			"settings": { "foreground": "#86D9A5" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#FFFFFF", "background": "#8B0000" }
		}
	],
	"semanticTokenColors": {
		"function": "#93C5FD",
		"method": "#93C5FD",
		"class": "#E5C07B",
		"interface": "#E5C07B",
		"type": "#E5C07B",
		"enum": "#E5C07B",
		"variable": "#E6E2F0",
		"parameter": { "foreground": "#D8C8F8", "italic": true },
		"property": "#93C5FD",
		"string": "#86D9A5",
		"number": "#F0ABFC",
		"keyword": "#C4A7F7",
		"comment": { "foreground": "#6E6A86", "italic": true }
	}
}
